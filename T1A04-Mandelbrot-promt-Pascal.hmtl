<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mandelbrot Explorer</title>
<style>
* { box-sizing: border-box; }
html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #000; }
canvas { position: fixed; inset: 0; display: block; width: 100%; height: 100%; }
#myCanvas { z-index: 0; }
#myOverlay { z-index: 1; pointer-events: none; }
#myHint {
  position: fixed; top: 16px; left: 16px; z-index: 3;
  padding: 12px 16px; color: white; background: #111d;
  border: 1px solid #a855f7; border-radius: 8px;
  font: 13px/1.5 system-ui; cursor: pointer;
}
#myHint strong { color: #d8a5ff; }
#myStatus {
  position: fixed; right: 14px; bottom: 12px; z-index: 3;
  color: #ddd; font: 12px system-ui; pointer-events: none;
}
#myModal {
  display: none; position: fixed; inset: 0; z-index: 5;
  align-items: center; justify-content: center;
  padding: 20px; background: #000c;
  color: #eee; font: 15px/1.7 system-ui;
}
#myModalContent {
  max-width: 520px; max-height: 90vh; overflow: auto;
  padding: 24px; border: 1px solid #a855f7;
  border-radius: 14px; background: #101019;
}
#myModal h2 { color: #d8a5ff; }
#myModal code { color: #70f5ff; }
#myClose {
  float: right; padding: 6px 12px; color: white;
  background: #222; border: 1px solid #666;
  border-radius: 6px; cursor: pointer;
}
</style>
</head>
<body>

<canvas id="myCanvas"></canvas>
<canvas id="myOverlay"></canvas>

<div id="myHint">
  <strong>✦ MANDELBROT EXPLORER</strong><br>
  Scroll to adjust preview zoom<br>
  Click to zoom in · Click here for info
</div>

<div id="myStatus">Starting…</div>

<div id="myModal">
  <div id="myModalContent">
    <button id="myClose">Close ✕</button>
    <h2>The Mandelbrot Set</h2>
    <p>The fractal is generated by repeating this equation:</p>
    <p style="text-align:center;font-size:22px">
      <code>Z<sub>n+1</sub> = Z<sub>n</sub><sup>2</sup> + C</code>
    </p>
    <p>Each pixel represents a complex number C. We start with Z = 0
    and repeatedly square Z, then add C. If the sequence escapes beyond
    a certain radius, the pixel is colored according to how quickly it
    escapes. Points that remain bounded form the Mandelbrot set.</p>
    <p>Move your mouse to position the preview. Scroll to change its
    zoom level. Click the canvas to zoom into that point. Press Escape
    to close this window.</p>
  </div>
</div>

<script>
const myCanvas = document.getElementById("myCanvas");
const myContext = myCanvas.getContext("2d", { alpha: false });
const myOverlay = document.getElementById("myOverlay");
const myOverlayContext = myOverlay.getContext("2d");
const myStatus = document.getElementById("myStatus");
const myHint = document.getElementById("myHint");
const myModal = document.getElementById("myModal");
const myClose = document.getElementById("myClose");

let myCenterX = -0.5;
let myCenterY = 0;
let myViewWidth = 3.5;
let myPreviewScale = 2;
let myPreviewSize = 150;
let myMouseX = innerWidth / 2;
let myMouseY = innerHeight / 2;
let myPixelRatio = 1;
let myRenderId = 0;
let myPreviewId = 0;
let myPreviewTimer = 0;
let myEscapeLimit = 220;

const myPreviewCanvas = document.createElement("canvas");
myPreviewCanvas.width = 180;
myPreviewCanvas.height = 180;
const myPreviewContext = myPreviewCanvas.getContext("2d");

function myResizeCanvas() {
  myPixelRatio = Math.min(devicePixelRatio || 1, 1.5);
  const myWidth = Math.max(1, Math.round(innerWidth * myPixelRatio));
  const myHeight = Math.max(1, Math.round(innerHeight * myPixelRatio));

  myCanvas.width = myWidth;
  myCanvas.height = myHeight;
  myOverlay.width = myWidth;
  myOverlay.height = myHeight;

  myCanvas.style.width = innerWidth + "px";
  myCanvas.style.height = innerHeight + "px";
  myOverlay.style.width = innerWidth + "px";
  myOverlay.style.height = innerHeight + "px";

  myRenderFractal();
}

function myGetPoint(myX, myY, myCenterReal, myCenterImaginary, myView) {
  const myAspect = myCanvas.width / myCanvas.height;
  return {
    real: myCenterReal + (myX / myCanvas.width - 0.5) * myView,
    imaginary: myCenterImaginary +
      (myY / myCanvas.height - 0.5) * myView / myAspect
  };
}

function myGetColor(myIteration, myMagnitudeSquared, myLimit) {
  if (myIteration >= myLimit) return [0, 0, 0];

  const mySmooth = myIteration + 1 -
    Math.log2(Math.max(1e-12,
      Math.log2(Math.max(1.000001, myMagnitudeSquared))));

  const myHue = ((mySmooth * 0.075) % 1 + 1) % 1;
  const mySector = myHue * 6;
  const myChroma = 0.96;
  const mySecondary = myChroma * (1 - Math.abs(mySector % 2 - 1));
  const myOffset = 1 - myChroma;
  let myRed = 0, myGreen = 0, myBlue = 0;

  if (mySector < 1) { myRed = myChroma; myGreen = mySecondary; }
  else if (mySector < 2) { myRed = mySecondary; myGreen = myChroma; }
  else if (mySector < 3) { myGreen = myChroma; myBlue = mySecondary; }
  else if (mySector < 4) { myGreen = mySecondary; myBlue = myChroma; }
  else if (mySector < 5) { myRed = mySecondary; myBlue = myChroma; }
  else { myRed = myChroma; myBlue = mySecondary; }

  const myGlow = 0.85 + 0.15 * (0.5 + 0.5 * Math.sin(mySmooth * 0.1));

  return [
    Math.round((myRed + myOffset) * 255 * myGlow),
    Math.round((myGreen + myOffset) * 255 * myGlow),
    Math.round((myBlue + myOffset) * 255 * myGlow)
  ];
}

async function myRenderToCanvas(
  myTargetCanvas, myTargetContext, myRealCenter, myImaginaryCenter,
  myView, myLimit, myJob, myIsPreview
) {
  const myWidth = myTargetCanvas.width;
  const myHeight = myTargetCanvas.height;
  const myAspect = myWidth / myHeight;
  const myImage = myTargetContext.createImageData(myWidth, myHeight);
  const myPixels = myImage.data;

  for (let myY = 0; myY < myHeight; myY++) {
    const myCurrentId = myIsPreview ? myPreviewId : myRenderId;
    if (myJob !== myCurrentId) return;

    const myImaginary = myImaginaryCenter +
      (myY / myHeight - 0.5) * myView / myAspect;

    for (let myX = 0; myX < myWidth; myX++) {
      const myReal = myRealCenter + (myX / myWidth - 0.5) * myView;

      let myZReal = 0;
      let myZImaginary = 0;
      let myZRealSquared = 0;
      let myZImaginarySquared = 0;
      let myIteration = 0;

      while (myZRealSquared + myZImaginarySquared <= 256 &&
             myIteration < myLimit) {
        myZImaginary = 2 * myZReal * myZImaginary + myImaginary;
        myZReal = myZRealSquared - myZImaginarySquared + myReal;
        myZRealSquared = myZReal * myZReal;
        myZImaginarySquared = myZImaginary * myZImaginary;
        myIteration++;
      }

      const myIndex = (myY * myWidth + myX) * 4;
      const myColor = myGetColor(
        myIteration, myZRealSquared + myZImaginarySquared, myLimit
      );

      myPixels[myIndex] = myColor[0];
      myPixels[myIndex + 1] = myColor[1];
      myPixels[myIndex + 2] = myColor[2];
      myPixels[myIndex + 3] = 255;
    }

    // Publish completed rows progressively.
    if (myY % 8 === 7 || myY === myHeight - 1) {
      if (myJob !== (myIsPreview ? myPreviewId : myRenderId)) return;
      myTargetContext.putImageData(myImage, 0, 0);
      await new Promise(myResolve => requestAnimationFrame(myResolve));
    }
  }
}

async function myRenderFractal() {
  const myJob = ++myRenderId;
  myEscapeLimit = Math.min(
    1400,
    Math.max(220, Math.floor(220 + 45 * Math.max(0, Math.log2(3.5 / myViewWidth))))
  );

  myStatus.textContent = "Rendering · " + (3.5 / myViewWidth).toFixed(1) + "×";

  await myRenderToCanvas(
    myCanvas, myContext, myCenterX, myCenterY,
    myViewWidth, myEscapeLimit, myJob, false
  );

  if (myJob === myRenderId) {
    myStatus.textContent = "Zoom " + (3.5 / myViewWidth).toFixed(1) + "×";
    myDrawOverlay();
  }
}

async function myRenderPreview() {
  const myJob = ++myPreviewId;
  const myPoint = myGetPoint(
    myMouseX * myPixelRatio, myMouseY * myPixelRatio,
    myCenterX, myCenterY, myViewWidth
  );

  await myRenderToCanvas(
    myPreviewCanvas, myPreviewContext,
    myPoint.real, myPoint.imaginary,
    myViewWidth / myPreviewScale,
    Math.min(myEscapeLimit, 320), myJob, true
  );

  if (myJob === myPreviewId) myDrawOverlay();
}

function myDrawOverlay() {
  const myWidth = myOverlay.width;
  const myHeight = myOverlay.height;
  myOverlayContext.clearRect(0, 0, myWidth, myHeight);

  if (myMouseX < 0 || myMouseX > innerWidth ||
      myMouseY < 0 || myMouseY > innerHeight) return;

  const myX = myMouseX * myPixelRatio;
  const myY = myMouseY * myPixelRatio;
  const mySize = myPreviewSize * myPixelRatio;

  myOverlayContext.save();
  myOverlayContext.drawImage(
    myPreviewCanvas, myX - mySize / 2, myY - mySize / 2, mySize, mySize
  );

  myOverlayContext.strokeStyle = "#fff";
  myOverlayContext.lineWidth = 1.5 * myPixelRatio;
  myOverlayContext.setLineDash([6 * myPixelRatio, 4 * myPixelRatio]);
  myOverlayContext.strokeRect(
    myX - mySize / 2, myY - mySize / 2, mySize, mySize
  );
  myOverlayContext.setLineDash([]);

  myOverlayContext.fillStyle = "#080810ee";
  myOverlayContext.fillRect(
    myX + 10 * myPixelRatio, myY + 10 * myPixelRatio,
    95 * myPixelRatio, 23 * myPixelRatio
  );
  myOverlayContext.fillStyle = "#fff";
  myOverlayContext.font = `${12 * myPixelRatio}px system-ui`;
  myOverlayContext.fillText(
    myPreviewScale.toFixed(1) + "× zoom",
    myX + 16 * myPixelRatio, myY + 26 * myPixelRatio
  );
  myOverlayContext.restore();
}

function mySchedulePreview() {
  clearTimeout(myPreviewTimer);
  myPreviewTimer = setTimeout(myRenderPreview, 80);
}

myCanvas.onmousemove = function(myEvent) {
  myMouseX = myEvent.clientX;
  myMouseY = myEvent.clientY;
  mySchedulePreview();
};

myCanvas.onmouseleave = function() {
  myMouseX = -1000;
  myPreviewId++;
  myDrawOverlay();
};

myCanvas.onwheel = function(myEvent) {
  myEvent.preventDefault();
  myPreviewScale = Math.max(
    1.2, Math.min(12, myPreviewScale * Math.exp(-myEvent.deltaY * 0.001))
  );
  myPreviewSize = Math.max(
    60, Math.min(320, 150 * Math.sqrt(myPreviewScale / 2))
  );
  mySchedulePreview();
};

myCanvas.onclick = function(myEvent) {
  const myPoint = myGetPoint(
    myEvent.clientX * myPixelRatio,
    myEvent.clientY * myPixelRatio,
    myCenterX, myCenterY, myViewWidth
  );

  myCenterX = myPoint.real;
  myCenterY = myPoint.imaginary;
  myViewWidth = Math.max(1e-14, myViewWidth / myPreviewScale);
  myRenderFractal();
  mySchedulePreview();
};

myHint.onclick = function() {
  myModal.style.display = "flex";
};
myClose.onclick = function() {
  myModal.style.display = "none";
};
myModal.onclick = function(myEvent) {
  if (myEvent.target === myModal) myModal.style.display = "none";
};
window.onkeydown = function(myEvent) {
  if (myEvent.key === "Escape") myModal.style.display = "none";
};
window.onresize = myResizeCanvas;

myResizeCanvas();
</script>
</body>
</html>
