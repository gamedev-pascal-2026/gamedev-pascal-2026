<h4>Maximum Array</h4>
<input type="button" value="Find Maximum" onClick="{
    let myArray = [10, 25, 5, 40, 15]
    let myMax = myArray[0]

    for (let i = 1; i < myArray.length; i++) {
        if (myArray[i] > myMax) {
            myMax = myArray[i]
        }
    }

    document.getElementById('myDiv02').innerHTML = 'Maximum: ' + myMax
}">
<div id="myDiv02">...</div>
<br>

<h4>Minimum Array</h4>
<input type="button" value="Find Minimum" onClick="{
    let myArray = [10, 25, 5, 40, 15]
    let myMin = myArray[0]

    for (let i = 1; i < myArray.length; i++) {
        if (myArray[i] < myMin) {
            myMin = myArray[i]
        }
    }

    document.getElementById('myDiv03').innerHTML = 'Minimum: ' + myMin
}">
<div id="myDiv03">...</div>
